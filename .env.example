# Ariel Agent OS server environment
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
ARIEL_OS_DATA_ROOT=./.ariel-os-data
# In production this must be a long random secret. Do not commit .env.
ARIEL_OS_API_TOKEN=

# Server-side provider credentials only. The React client never reads these values.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
