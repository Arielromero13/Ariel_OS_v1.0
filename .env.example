# Ariel Agent OS Environment Variables
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# Claude — solo server-side (función serverless api/claude.ts).
# Configúrala en Vercel: Settings → Environment Variables. Nunca en el
# cliente ni en este archivo con un valor real.
ANTHROPIC_API_KEY=
# Opcional — si se omite, api/claude.ts usa claude-sonnet-4-6 por defecto.
ANTHROPIC_MODEL=
