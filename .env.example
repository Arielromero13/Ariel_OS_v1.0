# Ariel Agent OS Environment Variables
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# Claude — solo server-side (función serverless api/claude.ts).
# Configúrala en Vercel: Settings → Environment Variables. Nunca en el
# cliente ni en este archivo con un valor real.
ANTHROPIC_API_KEY=
# Opcional — si se omite, api/claude.ts usa claude-sonnet-4-6 por defecto.
ANTHROPIC_MODEL=

# Telegram — solo server-side (función serverless api/telegram-webhook.ts).
# TELEGRAM_BOT_TOKEN lo entrega @BotFather al crear el bot.
# TELEGRAM_WEBHOOK_SECRET es un valor cualquiera que tú eliges; debe
# coincidir con el secret_token que registres al llamar setWebhook.
# Configura ambas en Vercel: Settings → Environment Variables. Nunca en
# el cliente ni en este archivo con un valor real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Vercel Blob — se genera solo al enlazar un Blob Store (gratuito, plan
# Hobby) al proyecto desde el dashboard de Vercel. No se configura a mano.
BLOB_READ_WRITE_TOKEN=
