{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arielromero13/ariel-agent-os/contracts/handoff.schema.json",
  "title": "Agent Handoff",
  "description": "Contrato universal para la entrega de trabajo entre roles. El handoff enlaza artefactos y no duplica su contenido.",
  "type": "object",
  "required": [
    "handoff_id",
    "context",
    "routing",
    "status",
    "summary",
    "artifacts",
    "request_to_recipient",
    "traceability"
  ],
  "properties": {
    "handoff_id": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "required": [
        "work_item_id",
        "case_id",
        "revision_id",
        "workflow",
        "domain"
      ],
      "properties": {
        "work_item_id": {
          "type": "string"
        },
        "case_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": [
        "from_role",
        "to_role",
        "stage_completed",
        "next_expected_action"
      ],
      "properties": {
        "from_role": {
          "type": "string"
        },
        "to_role": {
          "type": "string"
        },
        "stage_completed": {
          "type": "string"
        },
        "next_expected_action": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": [
        "readiness",
        "confidence",
        "correction_cycle"
      ],
      "properties": {
        "readiness": {
          "type": "string",
          "enum": [
            "ready_for_review",
            "ready_for_integration",
            "ready_for_visual_qa",
            "ready_for_audit",
            "needs_clarification",
            "blocked"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "correction_cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "completed_work",
        "key_result",
        "scope_covered",
        "scope_not_covered"
      ],
      "properties": {
        "completed_work": {
          "type": "string"
        },
        "key_result": {
          "type": "string"
        },
        "scope_covered": {
          "type": "string"
        },
        "scope_not_covered": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "type",
          "location",
          "status"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "approved_for_review",
              "approved",
              "superseded",
              "blocked"
            ]
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "summary"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "evidence_links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proposed_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "criterion_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "impact",
          "required_resolution"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "required_resolution": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decision_needed",
          "owner",
          "blocking"
        ],
        "properties": {
          "decision_needed": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "preservation": {
      "type": "object",
      "properties": {
        "artifacts_not_to_modify": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "request_to_recipient": {
      "type": "object",
      "required": [
        "objective",
        "acceptance_criteria",
        "allowed_actions",
        "prohibited_actions"
      ],
      "properties": {
        "objective": {
          "type": "string"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prohibited_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "traceability": {
      "type": "object",
      "required": [
        "source_revision",
        "generated_at"
      ],
      "properties": {
        "source_revision": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
