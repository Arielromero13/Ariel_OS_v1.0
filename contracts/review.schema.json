{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Arielromero13/ariel-agent-os/contracts/review.schema.json",
  "title": "Review Record",
  "description": "Contrato universal para revisión técnica o visual de artefactos, evidencia y hallazgos.",
  "type": "object",
  "required": [
    "review_id",
    "context",
    "reviewer",
    "scope",
    "checks",
    "decision",
    "lifecycle"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "context": {
      "type": "object",
      "required": [
        "case_id",
        "revision_id",
        "work_item_id",
        "workflow"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "work_item_id": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": [
        "role",
        "review_type",
        "independence_confirmed"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "review_type": {
          "type": "string",
          "enum": [
            "technical",
            "visual",
            "compliance",
            "other"
          ]
        },
        "independence_confirmed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "target_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_pages_or_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "area",
          "result"
        ],
        "properties": {
          "check_id": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "not_applicable"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "issue_id",
          "severity",
          "blocking",
          "description"
        ],
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "related_artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "outcome",
        "rationale"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "approve",
            "patch",
            "partial_rework",
            "full_rework",
            "escalate"
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "correction_request": {
      "type": "object",
      "properties": {
        "responsible_role": {
          "type": "string"
        },
        "correction_type": {
          "type": "string",
          "enum": [
            "patch",
            "partial_rework",
            "full_rework",
            "user_clarification"
          ]
        },
        "artifacts_to_modify": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts_to_preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "status",
        "correction_cycle"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "issued",
            "superseded",
            "resolved"
          ]
        },
        "correction_cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": {
              "outcome": {
                "enum": [
                  "patch",
                  "partial_rework",
                  "full_rework"
                ]
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "correction_request"
        ]
      }
    }
  ]
}
