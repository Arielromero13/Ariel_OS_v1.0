{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariel-agent-os.local/contracts/report-manifest.schema.json",
  "title": "Report Manifest",
  "description": "Inventario trazable e inmutable del paquete de entrega asociado a una revisión. Declara qué artefactos componen el entregable candidato, de dónde provienen, qué controles los cubren y si el paquete satisface la Definition of Done. No sustituye el informe ni autoriza su emisión externa.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_id",
    "context",
    "deliverable",
    "artifacts",
    "completeness",
    "quality_controls",
    "distribution",
    "lifecycle"
  ],
  "properties": {
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "description": "Identificador único del manifiesto y de su paquete de entrega."
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "revision_id", "work_item_id", "workflow_id"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "revision_id": { "type": "string", "minLength": 1 },
        "work_item_id": { "type": "string", "minLength": 1 },
        "workflow_id": { "type": "string", "minLength": 1 },
        "parent_manifest_id": {
          "type": "string",
          "minLength": 1,
          "description": "Manifiesto anterior del que deriva esta revisión, si existe."
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deliverable_id", "title", "purpose", "candidate_status"],
      "properties": {
        "deliverable_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "candidate_status": {
          "type": "string",
          "enum": [
            "draft",
            "under_review",
            "candidate_for_human_approval",
            "approved_for_release",
            "released",
            "no_emit",
            "superseded"
          ]
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "version_or_revision"],
          "properties": {
            "artifact_id": { "type": "string", "minLength": 1 },
            "version_or_revision": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "role",
          "artifact_type",
          "format",
          "location",
          "version_or_revision",
          "integrity",
          "source_revision_id",
          "status"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary_report",
              "rendered_report",
              "validated_control_matrix",
              "evidence_gallery",
              "technical_analysis",
              "normative_register",
              "pending_items_list",
              "appendix",
              "supporting_file",
              "other"
            ]
          },
          "artifact_type": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1, "description": "Ej.: docx, pdf, xlsx, json, md." },
          "location": {
            "type": "string",
            "minLength": 1,
            "description": "URI, ruta relativa o identificador del repositorio/almacenamiento autorizado."
          },
          "version_or_revision": { "type": "string", "minLength": 1 },
          "integrity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "type": "string", "enum": ["verified", "not_verified", "not_applicable"] },
              "sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$",
                "description": "Huella opcional para inmovilizar la versión exacta distribuida."
              }
            }
          },
          "source_revision_id": {
            "type": "string",
            "minLength": 1,
            "description": "Revisión del caso de la cual procede el artefacto."
          },
          "produced_by": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "agent_id": { "type": "string", "minLength": 1 }
            }
          },
          "depends_on_artifact_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "linked_record_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true,
            "description": "Referencias a evidencias, findings, revisiones o decisiones que respaldan este artefacto."
          },
          "status": {
            "type": "string",
            "enum": ["included", "required_but_missing", "excluded_with_reason", "superseded"]
          },
          "note": { "type": "string" }
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_of_done_checks", "missing_required_artifact_count", "open_critical_item_count"],
      "properties": {
        "definition_of_done_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dod_item_id", "requirement", "result", "basis"],
            "properties": {
              "dod_item_id": { "type": "string", "minLength": 1 },
              "requirement": { "type": "string", "minLength": 1 },
              "result": { "type": "string", "enum": ["satisfied", "not_satisfied", "pending", "not_applicable"] },
              "basis": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "note": { "type": "string" }
            }
          }
        },
        "missing_required_artifact_count": { "type": "integer", "minimum": 0 },
        "open_critical_item_count": { "type": "integer", "minimum": 0 }
      }
    },
    "quality_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical_review", "visual_qa", "intent_validation", "audit_decision"],
      "properties": {
        "technical_review": { "$ref": "#/$defs/controlReference" },
        "visual_qa": { "$ref": "#/$defs/controlReference" },
        "intent_validation": { "$ref": "#/$defs/controlReference" },
        "audit_decision": { "$ref": "#/$defs/controlReference" }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "human_approval_required", "status"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["internal", "restricted", "external", "unknown"]
        },
        "intended_recipients": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "human_approval_required": { "type": "boolean" },
        "human_approval_record_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["not_authorized", "pending_human_approval", "authorized_for_release", "released", "blocked"]
        },
        "released_at": { "type": "string", "format": "date-time" },
        "release_reference": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "created_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["draft", "issued", "superseded", "archived"]
        },
        "created_at": { "type": "string", "format": "date-time" },
        "superseded_by_manifest_id": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "controlReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "status"],
      "properties": {
        "record_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["approved", "passed", "pending", "failed", "not_applicable", "not_issued"]
        },
        "note": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deliverable": {
            "properties": {
              "candidate_status": {
                "enum": ["candidate_for_human_approval", "approved_for_release", "released"]
              }
            },
            "required": ["candidate_status"]
          }
        },
        "required": ["deliverable"]
      },
      "then": {
        "properties": {
          "completeness": {
            "properties": {
              "missing_required_artifact_count": { "const": 0 },
              "open_critical_item_count": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "distribution": {
            "properties": { "status": { "const": "released" } },
            "required": ["status"]
          }
        },
        "required": ["distribution"]
      },
      "then": {
        "properties": {
          "deliverable": {
            "properties": { "candidate_status": { "const": "released" } },
            "required": ["candidate_status"]
          },
          "distribution": {
            "properties": {
              "human_approval_required": { "const": true },
              "human_approval_record_id": { "type": "string", "minLength": 1 },
              "released_at": { "type": "string", "format": "date-time" },
              "release_reference": { "type": "string", "minLength": 1 }
            },
            "required": [
              "human_approval_required",
              "human_approval_record_id",
              "released_at",
              "release_reference"
            ]
          }
        }
      }
    }
  ]
}
